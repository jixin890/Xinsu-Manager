<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 底色：KernelSU 同款靛蓝，叠加对角渐变增强层次 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF33327A" />
                <item android:offset="0.55" android:color="#FF1E1B4B" />
                <item android:offset="1" android:color="#FF110F2C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 中心柔光，营造立体感 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="44"
                android:gradientRadius="60">
                <item android:offset="0" android:color="#3DA5B4FC" />
                <item android:offset="0.6" android:color="#141E1B4B" />
                <item android:offset="1" android:color="#001E1B4B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
